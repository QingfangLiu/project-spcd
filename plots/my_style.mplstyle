# ---------- Figure ----------
figure.figsize: 6, 5
figure.dpi: 300

# ---------- Fonts ----------
font.size: 15
axes.titlesize: 15
axes.labelsize: 15
legend.fontsize: 12

# ---------- Axes ----------
axes.linewidth: 1.2
axes.labelpad: 6

# ---------- Ticks ----------
xtick.labelsize: 14
ytick.labelsize: 14
xtick.major.width: 1.1
ytick.major.width: 1.1
xtick.major.size: 5
ytick.major.size: 5

# ---------- Lines ----------
lines.linewidth: 2.0
lines.markersize: 6

# ---------- Grid ----------
axes.grid: False

# ---------- Seaborn-like white style ----------
axes.facecolor: white
figure.facecolor: white
