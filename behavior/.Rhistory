ggplot(all_odor_pred_df,mapping = aes(x=Run,y=mean_acc, label = SubID)) +
geom_jitter(height = 0,width = 0.1, color = "blue") +
geom_text(vjust = -0.5, size = 3) +
labs(x = "Run", y = "Mean Accuracy", title = "Mean Accuracy per Run")
